package com.klef.soa.exam.service;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.klef.soa.exam.entity.BikeRental;
import com.klef.soa.exam.repository.BikeRentalRepository;

@Service
public class BikerentalServiceImpl 
{
	@Autowired
    private BikeRentalRepository repository;
	
	@Override
    public BikeRental add(BeautySalon salon) {
        return repository.save(salon);
    }

    @Override
    public List<BeautySalon> displayAll() {
        return repository.findAll();
    }

    @Override
    public String delete(long id) {

        if (repository.existsById(id)) {
            repository.deleteById(id);
            return "BeautySalon deleted successfully";
        } else {
            return "BeautySalon ID Not Found";
        }
    }

}
